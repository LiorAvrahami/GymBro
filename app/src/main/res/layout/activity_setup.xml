<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_folder" />

        <TextView
            android:id="@+id/setup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Where should GymBro keep your data?"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:text="Your training history is kept in a folder on your phone that you choose, so that it is never lost: not when GymBro is updated, and not even if GymBro is uninstalled.\n\nChoose a folder such as Documents (GymBro makes a GymBro folder inside it) and allow access.\n\nAfter reinstalling GymBro, choose the same folder again and all your data comes back."
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <Button
            android:id="@+id/setup_choose"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:text="Choose folder"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/setup_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/setup_continue"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Continue"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
