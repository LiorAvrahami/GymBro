<?xml version="1.0" encoding="utf-8"?>
<!-- A station (design/app_layout.free, page "StationSelectedPage"): its picture, name and back on top; the reps, the
     difficulty and the weight; edit and submit at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/station_image"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/bg_tile"
            android:contentDescription="Station pictures"
            android:padding="3dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/station_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/station_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/station_back"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_tile"
            android:contentDescription="Back"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/BigLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reps" />

                <TextView
                    android:id="@+id/station_reps_value"
                    style="@style/BigLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="30sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/station_reps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:valueFrom="6"
                android:valueTo="15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/BigLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Difficulty" />

                <TextView
                    android:id="@+id/station_difficulty_value"
                    style="@style/BigLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="30sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/station_difficulty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:valueFrom="1"
                android:valueTo="10" />

            <TextView
                style="@style/BigLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_horizontal"
                android:text="Weight used" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:id="@+id/station_weight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="140dp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/station_weight_up"
                        android:layout_width="88dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_tile"
                        android:contentDescription="More weight"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tri_up" />

                    <ImageButton
                        android:id="@+id/station_weight_down"
                        android:layout_width="88dp"
                        android:layout_height="72dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_tile"
                        android:contentDescription="Less weight"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tri_down" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/station_increment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/station_edit"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tile"
            android:contentDescription="Edit this station"
            android:padding="26dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_edit" />

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/station_submit"
            android:layout_width="170dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_submit"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_check" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Submit"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
