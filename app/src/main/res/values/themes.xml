<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GymBro" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#003548</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/card</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <!-- a big gray bold label above a control (the station page's sliders) -->
    <style name="BigLabel">
        <item name="android:textColor">@color/label_gray</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
